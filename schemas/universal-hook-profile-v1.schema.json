{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qingjian0.github.io/apps/schemas/universal-hook-profile-v1.schema.json",
  "title": "Universal Hook Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaMajor", "profileId", "revision", "status", "host", "roles"],
  "properties": {
    "schemaMajor": { "const": 1 },
    "profileId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,95}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["DRAFT", "STATIC_VERIFIED", "RUNTIME_VERIFIED", "DEPRECATED", "QUARANTINED"] },
    "host": { "$ref": "#/$defs/host" },
    "roles": { "type": "array", "items": { "$ref": "#/$defs/role" }, "minItems": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "evidenceFamily": {
      "enum": ["PROTOCOL_ANCHOR", "TYPE_SHAPE", "CALL_GRAPH", "CONTROL_FLOW", "BYTECODE_SHAPE", "DATA_FLOW", "FRAMEWORK_INTERACTION", "RUNTIME_BEHAVIOR", "HOST_IDENTITY"]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "versionName", "versionCode", "signingCertSha256", "baseApkSha256", "splitApkSha256", "dexFingerprint"],
      "properties": {
        "packageName": { "type": "string", "minLength": 3 },
        "versionName": { "type": "string", "minLength": 1 },
        "versionCode": { "type": "integer", "minimum": 1 },
        "signingCertSha256": { "$ref": "#/$defs/sha256" },
        "baseApkSha256": { "$ref": "#/$defs/sha256" },
        "splitApkSha256": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "dexFingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "descriptor"],
      "properties": {
        "owner": { "type": "string", "pattern": "^L[^.;\\[\\(]+;$" },
        "name": { "type": "string", "minLength": 1 },
        "descriptor": { "type": "string", "pattern": "^\\([^)]*\\).+$" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "requiredEvidenceFamilies"],
      "properties": {
        "method": { "$ref": "#/$defs/method" },
        "requiredEvidenceFamilies": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceFamily" } },
        "forbiddenEvidenceCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9_.:-]{1,96}$" } }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "candidates", "minimumEvidenceFamilies", "requiredEvidenceFamilies"],
      "properties": {
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,95}$" },
        "candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/candidate" } },
        "minimumEvidenceFamilies": { "type": "integer", "minimum": 1 },
        "requiredEvidenceFamilies": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceFamily" } },
        "forbiddenEvidenceCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9_.:-]{1,96}$" } }
      }
    }
  }
}
